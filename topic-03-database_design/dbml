Table Locations {
  location_id integer [pk, increment, unique]
  location_city varchar(50)
  location_street varchar(100)
  location_building integer
  location_phone varchar(20)
  location_email varchar(254)
  opening_time time
  closing_time time
  seating_capacity integer
}

Table Roles {
  role_id integer [pk, increment, unique]
  role_name varchar(50)
}

Table Staff {
  employee_id integer [pk, increment, unique]
  role_id integer [ref: > Roles.role_id]
  location_id integer [ref: > Locations.location_id]
  employee_fname varchar(50)
  employee_lname varchar(50)
  employee_phone varchar(20)
  employee_email varchar(254)
  hourly_rate "decimal(10, 2)"
}

Table MenuCategory {
  category_id integer [pk, increment, unique]
  category_name varchar(50)
}

Table MenuItems {
  item_id integer [pk, increment, unique]
  category_id integer [ref: > MenuCategory.category_id]
  item_name varchar(100)
  item_description varchar(500)
  preparation_time integer
  cost_price "decimal(10, 2)"
  sell_price "decimal(10, 2)"
}

Table Customers {
  customer_id integer [pk, increment, unique]
  first_name varchar(50)
  last_name varchar(50)
  email_address varchar(255) [unique]
  phone varchar(20) [null]
  delivery_address varchar(255) [null]
}

Table Orders {
  order_id integer [pk, increment, unique]
  location_id integer [ref: > Locations.location_id]
  customer_id integer [ref: > Customers.customer_id]
  employee_id integer [ref: > Staff.employee_id]
  order_status varchar(20)
  order_type varchar(8)
  order_datetime datetime
  payment_method varchar(20)
}

Table Suppliers {
  supplier_id integer [pk, increment, unique]
  supplier_name varchar(100)
  contact_person varchar(100)
  phone varchar(30)
  email varchar(100)
  address varchar(255)
}

Table Ingredients {
  ingredient_id integer [pk, increment, unique]
  ingredient_name varchar(100)
  unit varchar(20)
  cost_per_unit decimal
  supplier_id integer [ref: > Suppliers.supplier_id]
}

Table BasicInventory {
  inventory_id integer [pk, increment, unique]
  ingredient_id integer [ref: > Ingredients.ingredient_id]
  location_id integer [ref: > Locations.location_id]
  quantity_in_stock decimal [default: 0]
  minimum_quantity decimal [default: 0]
  last_updated timestamp [default: `CURRENT_TIMESTAMP`]
  expiration_date date [null]
  storage_location varchar(100) [null]
}

Table CustomerFeedback {
  customerfeedback_id integer [pk, increment, unique]
  customer_id integer [ref: > Customers.customer_id]
  location_id integer [ref: > Locations.location_id]
  order_id integer [ref: > Orders.order_id]
  rating integer
  comment varchar(255)
  feedback_date datetime
}

Table OrderDetails {
  order_id integer [ref: > Orders.order_id]
  item_id integer [ref: > MenuItems.item_id]
  quantity "decimal(10, 2)"
  total_price "decimal(10, 2)"
}

Table Recipe {
  item_id integer [ref: > MenuItems.item_id]
  ingredient_id integer [ref: > Ingredients.ingredient_id]
  quantity_required "decimal(10, 2)"
  unit varchar(30)
}
